
classDiagram
    class Task {
        +description: str
        +time: str
        +frequency: str
        +completed: bool
        +due_date: date
        +pet_name: Optional~str~
        +mark_complete() None
    }

    class Pet {
        +name: str
        +species: str
        +tasks: List~Task~
        +add_task(task: Task) None
        +get_tasks() List~Task~
    }

    class Owner {
        +name: str
        +pets: List~Pet~
        +add_pet(pet: Pet) None
        +get_all_tasks() List~Task~
    }

    class Scheduler {
        +owner: Owner
        +sort_by_time() List~Task~
        +filter_tasks(pet_name, completed) List~Task~
        +detect_conflicts() List~str~
        +mark_task_complete(task: Task) None
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : stores
    Scheduler --> "1" Owner : holds reference
    Scheduler ..> Task : reads and completes
    Scheduler ..> Pet : adds recurring task to
